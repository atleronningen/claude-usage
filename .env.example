# Én blokk per Claude-konto. Nummeret binder linjene sammen; LABEL er
# fritekst og vises i menyen – bruk gjerne plantypen.
#
# SESSION_KEY er verdien til cookien «sessionKey» på claude.ai (sk-ant-…):
# Chrome → utviklerverktøy → Application → Cookies → https://claude.ai.
# Appen finner selv riktig organisasjon og usage-adresse.
CLAUDE_USAGE_ACCOUNT_1_LABEL=Pro
CLAUDE_USAGE_ACCOUNT_1_SESSION_KEY=sk-ant-lim-inn-her

# Hver konto trenger sin egen sessionKey, hentet mens du er logget inn som
# den kontoen (én Chrome-profil per konto). Fjern blokken under hvis du bare
# har én konto.
CLAUDE_USAGE_ACCOUNT_2_LABEL=Team Plan
CLAUDE_USAGE_ACCOUNT_2_SESSION_KEY=sk-ant-lim-inn-her

# Gamle oppsett virker fortsatt: en hel Cookie-header i _COOKIE, eller
# CLAUDE_USAGE_COOKIE uten nummer. _API_URL leses ikke lenger.
