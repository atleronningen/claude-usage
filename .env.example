# Én blokk per Claude-konto. Nummeret binder linjene sammen; LABEL er
# fritekst og vises i menyen — bruk gjerne plantypen.
CLAUDE_USAGE_ACCOUNT_1_LABEL=Pro
CLAUDE_USAGE_ACCOUNT_1_COOKIE=lim-inn-cookie-header-fra-devtools-her
CLAUDE_USAGE_ACCOUNT_1_API_URL=https://claude.ai/api/organizations/DIN-ORG-ID/usage

# Hver konto trenger sin egen cookie, hentet mens du er logget inn som den
# kontoen. Fjern blokken under hvis du bare har én konto.
CLAUDE_USAGE_ACCOUNT_2_LABEL=Team Plan
CLAUDE_USAGE_ACCOUNT_2_COOKIE=lim-inn-cookie-header-fra-devtools-her
CLAUDE_USAGE_ACCOUNT_2_API_URL=https://claude.ai/api/organizations/ANNEN-ORG-ID/usage

# Gamle oppsett virker fortsatt: står CLAUDE_USAGE_COOKIE og
# CLAUDE_USAGE_API_URL alene, tolkes de som én konto.
